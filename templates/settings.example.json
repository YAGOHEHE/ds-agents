{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.env)",
      "Read(*.env.*)",
      "Read(!.env.example)",
      "Read(!*.env.example)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(*.env)",
      "Edit(*.env.*)",
      "Edit(!.env.example)",
      "Edit(!*.env.example)",
      "Edit(data/**/raw/**)",
      "Edit(data/**/01_raw/**)",
      "Edit(mlflow.db)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "PowerShell(Get-Content *.env*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git clean:*)",
      "Bash(git tag:*)",
      "Bash(git stash:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git push:*)",
      "PowerShell(git merge:*)",
      "PowerShell(git rebase:*)",
      "PowerShell(git reset:*)",
      "PowerShell(git checkout:*)",
      "PowerShell(git restore:*)",
      "PowerShell(git clean:*)",
      "PowerShell(git tag:*)",
      "PowerShell(git stash:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "PowerShell(gh pr create:*)",
      "PowerShell(gh pr merge:*)",
      "Bash(psql:*)",
      "Bash(pg_dump:*)",
      "Bash(pg_restore:*)",
      "Bash(mysql:*)",
      "Bash(sqlcmd:*)",
      "PowerShell(psql:*)",
      "PowerShell(pg_dump:*)",
      "PowerShell(pg_restore:*)",
      "PowerShell(mysql:*)",
      "PowerShell(sqlcmd:*)"
    ],
    "ask": [
      "Bash(rm:*)",
      "PowerShell(Remove-Item:*)",
      "Edit(uv.lock)",
      "Edit(poetry.lock)"
    ],
    "allow": [
      "Bash(ls:*)",
      "Bash(dir:*)",
      "Bash(pwd)",
      "PowerShell(Get-ChildItem:*)",
      "PowerShell(Get-Location)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "PowerShell(git status:*)",
      "PowerShell(git log:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git show:*)",
      "PowerShell(git branch:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(uv run:*)",
      "Bash(pytest:*)",
      "Bash(conda env list)",
      "Bash(conda run:*)",
      "PowerShell(python:*)",
      "PowerShell(pip:*)",
      "PowerShell(uv run:*)",
      "PowerShell(pytest:*)",
      "PowerShell(conda env list)",
      "PowerShell(conda run:*)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
